# =========================================================
# FAVICON REDIRECT
# Redirect /favicon.ico ke img/icon.png
# =========================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^favicon\.ico$ img/icon.png [L]

    # Sitemap dinamis: URL publik tetap /sitemap.xml (yang didaftarkan di
    # Search Console & robots.txt), isinya dibuat oleh sitemap.php
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# =========================================================
# BLOKIR FILE SENSITIF
# File-file ini tidak untuk publik: log error (berisi path server),
# dump database, file bahasa mentah, arsip backup, dokumentasi internal.
# =========================================================
<FilesMatch "^(error_log|.*\.(sql|ini|log|zip|bak|md)|READ-ME\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Folder .git & .gitignore jangan pernah bisa diakses (kalau deploy via git clone)
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git
</IfModule>

# =========================================================
# GZIP COMPRESSION
# =========================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# =========================================================
# BROWSER CACHING
# =========================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Images — cache 6 bulan
    ExpiresByType image/jpeg    "access plus 6 months"
    ExpiresByType image/png     "access plus 6 months"
    ExpiresByType image/gif     "access plus 6 months"
    ExpiresByType image/webp    "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/x-icon  "access plus 1 year"

    # CSS & JS — cache 1 bulan
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"

    # Video — cache 1 minggu
    ExpiresByType video/mp4  "access plus 1 week"
    ExpiresByType video/webm "access plus 1 week"

    # Font — cache 1 tahun
    ExpiresByType font/woff2         "access plus 1 year"
    ExpiresByType font/woff          "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # HTML — jangan cache (supaya konten terbaru selalu muncul)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# =========================================================
# SECURITY HEADERS
# =========================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
